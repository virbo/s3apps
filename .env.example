# ==============================================================================
# S3 File Manager Configuration (Single Source of Truth)
# ==============================================================================

# --- MinIO / S3 Storage Credentials ---
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=my-bucket
S3_SECURE=false
S3_REGION=us-east-1

# --- Backend Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173

# --- PostgreSQL Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=s3app_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/s3app_db

# --- JWT Authentication ---
JWT_SECRET_KEY=s3apps-secret-key-super-secure-change-in-prod-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Default Admin User Seed ---
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=Administrator
